# Copy to cluster.env (gitignored) and fill in. Used by scripts/render.sh
# Internal TLD resolved by the LAN DNS: services answer on <service>.$INTERNAL_DOMAIN
INTERNAL_DOMAIN=cluster
# Public (sub)domain covered by the wildcard certificate: <service>.$PUBLIC_DOMAIN
PUBLIC_DOMAIN=cluster.example.com
ACME_EMAIL=you@example.com
NODE_IP=192.168.x.x
NFS_SERVER_IP=192.168.x.x
TRAEFIK_LB_IP=192.168.x.x
